{{ form_start(form) }}
{% set selectedColor = form.couleur_categorie.vars.value ?: '#3b82f6' %}
<div class="row d-flex justify-content-between gap-3">
	<div class="col mt-3">
		{{form_label(form.nom_categorie)}}
		{{ form_widget(form.nom_categorie) }}
	</div>
	<div class="col mt-3">
		{{form_label(form.couleur_categorie)}}
		<div class="d-flex align-items-center gap-3">
			{{ form_widget(form.couleur_categorie) }}
			<span data-categorie-color-preview="true" data-default-color="{{ selectedColor }}" class="border rounded-circle d-inline-block" style="width: 2.5rem; height: 2.5rem; background-color: {{ selectedColor }};"></span>
			<span data-categorie-color-value="true" class="text-muted">{{ selectedColor }}</span>
		</div>
		{{ form_help(form.couleur_categorie) }}
	</div>
</div>
<div class="col mt-3">
	{{form_label(form.icone_categorie)}}
	<div class="d-flex flex-wrap gap-2">
		{% for choice in form.icone_categorie %}
			{{ form_widget(choice) }}
			<label for="{{ choice.vars.id }}" class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center" style="width: 3rem; height: 3rem;">
				<i class="{{ choice.vars.value }}" aria-hidden="true"></i>
			</label>
		{% endfor %}
	</div>
</div>

<div class="text-center">
	{{form_widget(form.save) }}
</div>
{{ form_end(form) }}
