{% extends 'base.html.twig' %}

{% block title %}
	{{ title }}
{% endblock %}

{% block body %}
	<h1>{{ title }}</h1>
	<h2>Voici la liste de vos catégories</h2>
	<table class="table">
		<thead>
			<tr>
				<th>Nom_categorie</th>
				<th>Couleur_categorie</th>
				<th>Icone_categorie</th>
				<th>actions</th>
			</tr>
		</thead>
		<tbody>
			{% for categorie in categories %}
				<tr>
					<td>{{ categorie.nomCategorie }}</td>
					<td>
						<span class="border rounded-circle d-inline-block" style="width: 2.5rem; height: 2.5rem; background-color: {{ categorie.couleurCategorie }};"></span>
					</td>
					<td style="color: {{ categorie.couleurCategorie }};">
						{% if categorie.iconeCategorieClass %}
							<i class="{{ categorie.iconeCategorieClass }}"></i>
						{% endif %}
					</td>
					<td>
						<a href="{{ path('app_categorie_edit', {'id': categorie.id}) }}">
							<i class="fas fa-edit"></i>
						</a>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="4">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

{% endblock %}
