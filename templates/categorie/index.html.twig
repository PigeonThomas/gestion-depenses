{% extends 'base.html.twig' %}

{% block title %}
	{{ title }}
{% endblock %}

{% block body %}
	<h1>{{ title }}</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Nom_categorie</th>
				<th>Couleur_categorie</th>
				<th>Icone_categorie</th>
				<th>actions</th>
			</tr>
		</thead>
		<tbody>
			{% for categorie in categories %}
				<tr>
					<td>{{ categorie.nomCategorie }}</td>
					<td>{{ categorie.couleurCategorie }}</td>
					<td>{{ categorie.iconeCategorie }}</td>
					<td>
						<a href="{{ path('app_categorie_show', {'id': categorie.id}) }}">
							<i class="fas fa-eye"></i>
						</a>
						<a href="{{ path('app_categorie_edit', {'id': categorie.id}) }}">
							<i class="fas fa-edit"></i>
						</a>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="4">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

{% endblock %}
