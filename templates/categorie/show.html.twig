{% extends 'base.html.twig' %}

{% block title %}
	{{ title }}
{% endblock %}

{% block body %}
	<h1>{{ title }}</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Nom de la catégorie</th>
				<td>{{ categorie.nomCategorie }}</td>
			</tr>
			<tr>
				<th>Couleur de la catégorie</th>
				<td>
					<span class="border rounded-circle d-inline-block" style="width: 2.5rem; height: 2.5rem; background-color: {{ categorie.couleurCategorie }};"></span>
				</td>
			</tr>
			<tr>
				<th>Icône de la catégorie</th>
				<td>
					{% if categorie.iconeCategorieClass %}
						<i class="{{ categorie.iconeCategorieClass }}"></i>
					{% endif %}
				</td>
			</tr>
		</tbody>
	</table>

	<div class="d-flex justify-content-between mb-3">
		<a href="{{ path('app_categorie_index') }}" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			Retour à la liste</a>
		<a href="{{ path('app_categorie_edit', {'id': categorie.id}) }}" class="btn btn-primary">
			<i class="fas fa-edit"></i>
			Modifier</a>
		{{ include('categorie/_delete_form.html.twig') }}
	</div>


{% endblock %}
