{% extends 'base.html.twig' %}

{% block title %}Connexion
{% endblock %}

{% block body %}
	{% include 'partials/_navbar.html.twig' %}

	<div class="d-flex align-items-center justify-content-center py-3">
		<div class="card shadow-sm border-0 w-100" style="max-width: 440px;">
			<div class="card-body p-4 p-md-5">

				<div class="text-center mb-4">
					<div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-4 mb-3" style="width: 56px; height: 56px;">
						<i class="fa-solid fa-lock fs-5"></i>
					</div>
					<h1 class="h4 fw-semibold mb-1">Veuillez vous connecter</h1>
					<p class="text-muted small">Accédez à votre espace de gestion des dépenses.</p>
				</div>

				{% if error %}
					<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
				{% endif %}

				{% if app.user %}
					<div class="alert alert-info">
						Vous êtes connecté en tant que
						{{ app.user.userIdentifier }}.
						<a href="{{ logout_path() }}" class="alert-link">Se déconnecter</a>
					</div>
				{% endif %}

				<form method="post">
					<div class="form-floating mb-3">
						<input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" placeholder="name@example.com" autocomplete="email" required autofocus>
						<label for="username">Adresse email</label>
					</div>
					<div class="form-floating mb-3">
						<input type="password" name="_password" id="password" class="form-control" placeholder="Mot de passe" autocomplete="current-password" required>
						<label for="password">Mot de passe</label>
					</div>

					<input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

					<div class="form-check mb-3">
						<input class="form-check-input" type="checkbox" name="_remember_me" id="_remember_me">
						<label class="form-check-label" for="_remember_me">Se souvenir de moi</label>
					</div>

					<button class="btn btn-primary w-100 py-2" type="submit">Connexion</button>
				</form>

				<p class="text-center text-muted small mt-4 mb-0">
					Pas encore de compte ?
					<a href="{{ path('app_register') }}" class="text-primary text-decoration-none fw-medium">S'inscrire</a>
				</p>

			</div>
		</div>
	</div>
{% endblock %}
