{% extends 'base.html.twig' %}

{% block title %}
	{{ title }}
{% endblock %}

{% block body %}
	<div class="container my-3">
		<h1>
			<strong>Dashboard</strong>
		</h1>
		<h2>Bienvenue sur votre tableau de bord de gestion des dépenses !</h2>
		<p>
			Ici, vous pouvez suivre et gérer toutes vos dépenses.
		</p>

		<div class="container">
			<div class="col-md-12 mb-4">
				<div class="card rounded-5 shadow">
					<div class="card-body">
						<h5 class="card-title text-center">Dépenses des 6 derniers mois</h5>
						<div id="bar-six-month-wrapper" style="height: 400px; width: 100%;">
							{{ render_chart(chartSixMonth) }}
						</div>
					</div>
				</div>
			</div>

			<div class="row g-4">
				<div class="col-md">
					<a href="{{ path('app_dashboard', {period: 'current'}) }}" class="text-decoration-none">
						<div class="card rounded-5 {{ period == 'current' ? 'bg-primary text-white' : '' }}">
							<div class="card-body">
								<h5 class="card-title">Dépenses du mois</h5>
								<p class="card-text">Total des dépenses pour le mois en cours :
									<strong>{{ totalDepenseActualMonth }}</strong>
									€</p>
							</div>
						</div>
					</a>
				</div>
				<div class="col-md">
					<a href="{{ path('app_dashboard', {period: 'last'}) }}" class="text-decoration-none">
						<div class="card rounded-5 {{ period == 'last' ? 'bg-primary text-white' : '' }}">
							<div class="card-body">
								<h5 class="card-title">Dépenses du mois précédent</h5>
								<p class="card-text">Total des dépenses du mois précédent :
									<strong>{{ totalDepenseLastMonth }}</strong>
									€</p>
							</div>
						</div>
					</a>
				</div>
			</div>

			<div id="donuts-section" class="mt-4">
				<h5 id="donuts-section-title" class="text-center text-muted mb-3">
					{% if period == 'current' %}Dépenses du mois en cours{% else %}Dépenses du mois précédent
					{% endif %}
				</h5>
				<div class="row g-4">
					<div class="col-md-6">
						<div class="card rounded-5 shadow">
							<div class="card-body">
								<h5 class="card-title text-center">Dépenses par catégories</h5>
								<div id="donut-categorie-wrapper" style="height: 400px; width: 100%;">
									{{ render_chart(chartCategorie) }}
								</div>
							</div>
						</div>
					</div>
					<div class="col-md-6">
						<div class="card rounded-5 shadow">
							<div class="card-body">
								<h5 class="card-title text-center">Dépenses par magasins</h5>
								<div id="donut-magasin-wrapper" style="height: 400px; width: 100%;">
									{{ render_chart(chartMagasin) }}
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	// Permet d'afficher les pourcentages sur les graphiques en camembert
	<script>
		document.addEventListener('chartjs:pre-connect', function (event) { // Vérifie si le graphique est de type 'doughnut' (camembert)
if (event.detail.config.type === 'doughnut') { // Configure le plugin datalabels pour afficher les pourcentages
event.detail.config.options.plugins.datalabels.formatter = function (value, context) {
var data = context.chart.data.datasets[0].data;
// Récupère les données du graphique
// Calcule le total des données pour obtenir le pourcentage
var total = data.reduce(function (acc, val) {
return acc + parseFloat(val);
}, 0);
// Évite la division par zéro
if (total === 0) 
return '0 %';



// Calcule et retourne le pourcentage arrondi
return Math.round((parseFloat(value) / total) * 100) + ' %';
};
}
});
	</script>
	<script id="six-month-donut-data" type="application/json">
		{{ sixMonthDonutData|json_encode|raw }}
	</script>
	<script src="{{ asset('js/sixmonth-graph-click.js') }}"></script>
{% endblock %}
