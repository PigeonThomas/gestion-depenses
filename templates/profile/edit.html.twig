{% extends 'base.html.twig' %}

{% block title %}Mon profil
{% endblock %}

{% block body %}
	<div class="container py-4">
		<div class="row justify-content-center">
			<div class="col-12 col-lg-8">
				<h1 class="mb-4">Mon profil</h1>

				{% for message in app.flashes('success') %}
					<div class="alert alert-success">{{ message }}</div>
				{% endfor %}

				<div class="card shadow-sm border-0">
					<div class="card-body p-4">
						<div class="d-flex align-items-center gap-3 mb-4">
							{% if user.imageUser %}
								<img src="{{ vich_uploader_asset(user, 'imageUserFile') }}" alt="Avatar de {{ user.prenomUser ?: user.nomUser ?: user.userIdentifier }}" class="rounded-circle object-fit-cover" width="72" height="72">
							{% else %}
								<span class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
									<i class="fa-solid fa-user fs-4"></i>
								</span>
							{% endif %}
							<div>
								<h2 class="h5 mb-1">{{ user.prenomUser ?: user.nomUser ?: user.userIdentifier }}</h2>
								<p class="text-body-secondary mb-0">Mettez à jour vos informations et votre photo de profil.</p>
							</div>
						</div>

						{{ form_start(form) }}
						<div class="mb-3">{{ form_row(form.email) }}</div>
						<div class="mb-3">{{ form_row(form.nom_user) }}</div>
						<div class="mb-3">{{ form_row(form.prenom_user) }}</div>
						<div class="mb-3">{{ form_row(form.adresse_user) }}</div>
						<div class="mb-4">{{ form_row(form.imageUserFile) }}</div>
						{{ form_row(form.save) }}
						{{ form_end(form) }}
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
