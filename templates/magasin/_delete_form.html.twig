<form method="post" action="{{ path('app_magasin_delete', {'id': magasin.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce magasin ?');">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ magasin.id) }}">
	<button class="btn btn-danger">Supprimer
		<i class="fas fa-trash"></i>
	</button>
</form>
