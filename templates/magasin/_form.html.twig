{{ form_start(form) }}
{{ form_errors(form) }}
<div class="row d-flex justify-content-between gap-3">
	<div class="col mt-3">
		{{form_label(form.nom_magasin)}}
		{{ form_widget(form.nom_magasin) }}
		{{ form_errors(form.nom_magasin) }}
	</div>
</div>
<div class="row d-flex justify-content-between gap-3">
	<div class="col mt-3">
		{{form_label(form.online_magasin)}}
		<div>
			{% for choices in form.online_magasin %}
				<div class="form-check form-check-inline">
					{{ form_widget(choices, {'attr': {'class': 'form-check-input'}}) }}
					{{ form_label(choices, null, {'label_attr': {'class': 'form-check-label'}}) }}
				</div>
			{% endfor %}
		</div>
		{{ form_errors(form.online_magasin) }}
	</div>
	<div class="col mt-3">
		{{form_label(form.lien_magasin)}}
		{{ form_widget(form.lien_magasin) }}
		{{ form_errors(form.lien_magasin) }}
	</div>
</div>
<div class="row d-flex justify-content-between gap-3">
	<div class="col mt-3">
		{{form_label(form.adresse_magasin)}}
		{{ form_widget(form.adresse_magasin) }}
		{{ form_errors(form.adresse_magasin) }}
	</div>
</div>
<div class="text-center">
	{{form_widget(form.save) }}
</div>

{{ form_end(form) }}
