{% extends 'base.html.twig' %}

{% block title %}
	{{ title }}
{% endblock %}

{% block body %}
	<h1>{{ title }}</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Id</th>
				<td>{{ magasin.id }}</td>
			</tr>
			<tr>
				<th>Nom</th>
				<td>{{ magasin.nomMagasin }}</td>
			</tr>
			<tr>
				<th>En ligne</th>
				<td>{{ magasin.onlineMagasin ? 'Oui' : 'Non' }}</td>
			</tr>
			<tr>
				<th>Adresse</th>
				<td>{{ magasin.adresseMagasin }}</td>
			</tr>
			<tr>
				<th>Lien</th>
				<td>{{ magasin.lienMagasin }}</td>
			</tr>
		</tbody>
	</table>

	<div class="d-flex justify-content-between mb-3">
		<a href="{{ path('app_magasin_index') }}" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			Retour à la liste</a>
		<a href="{{ path('app_magasin_edit', {'id': magasin.id}) }}" class="btn btn-primary">
			<i class="fas fa-edit"></i>
			Modifier</a>
		{{ include('magasin/_delete_form.html.twig') }}
	</div>
{% endblock %}
