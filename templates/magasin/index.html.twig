{% extends 'base.html.twig' %}

{% block title %}
	{{ title }}
{% endblock %}

{% block body %}
	<h1>{{ title }}</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Nom_magasin</th>
				<th>Online_magasin</th>
				<th>Adresse_magasin</th>
				<th>Lien_magasin</th>
				<th>actions</th>
			</tr>
		</thead>
		<tbody>
			{% for magasin in magasins %}
				<tr>
					<td>{{ magasin.nomMagasin }}</td>
					<td>{{ magasin.onlineMagasin ? 'Yes' : 'No' }}</td>
					<td>{{ magasin.adresseMagasin }}</td>
					<td>{{ magasin.lienMagasin }}</td>
					<td>
						<a href="{{ path('app_magasin_show', {'id': magasin.id}) }}">
							<i class="fas fa-eye"></i>
						</a>
						<a href="{{ path('app_magasin_edit', {'id': magasin.id}) }}">
							<i class="fas fa-edit"></i>
						</a>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="5">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

{% endblock %}
