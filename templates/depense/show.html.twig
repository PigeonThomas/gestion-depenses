{% extends 'base.html.twig' %}

{% block title %}Depense{% endblock %}

{% block body %}
    <h1>Depense</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ depense.id }}</td>
            </tr>
            <tr>
                <th>Date_depense</th>
                <td>{{ depense.dateDepense ? depense.dateDepense|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Montant_depense</th>
                <td>{{ depense.montantDepense }}</td>
            </tr>
            <tr>
                <th>Commentaire_depense</th>
                <td>{{ depense.commentaireDepense }}</td>
            </tr>
            <tr>
                <th>Facture_depense</th>
                <td>{{ depense.factureDepense }}</td>
            </tr>
            <tr>
                <th>Km_vehicule</th>
                <td>{{ depense.kmVehicule }}</td>
            </tr>
            <tr>
                <th>Carbu_prix_litre</th>
                <td>{{ depense.carbuPrixLitre }}</td>
            </tr>
            <tr>
                <th>Repa_description</th>
                <td>{{ depense.repaDescription }}</td>
            </tr>
            <tr>
                <th>Repa_ref_pieces</th>
                <td>{{ depense.repaRefPieces }}</td>
            </tr>
            <tr>
                <th>Repa_photos</th>
                <td>{{ depense.repaPhotos }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_depense_index') }}">back to list</a>

    <a href="{{ path('app_depense_edit', {'id': depense.id}) }}">edit</a>

    {{ include('depense/_delete_form.html.twig') }}
{% endblock %}
