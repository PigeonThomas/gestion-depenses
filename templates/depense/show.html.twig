{% extends 'base.html.twig' %}

{% block title %}Dépense
{% endblock %}

{% block body %}
	<h1>Dépense du
		{{ depense.dateDepense ? depense.dateDepense|date('d-m-Y') : '' }}</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Date de la dépense</th>
				<td>{{ depense.dateDepense ? depense.dateDepense|date('d-m-Y') : '' }}</td>
			</tr>
			<tr>
				<th>Montant de la dépense</th>
				<td>{{ depense.montantDepense }}
					€</td>
			</tr>
			<tr>
				<th>Commentaire de la dépense</th>
				<td>{{ depense.commentaireDepense }}</td>
			</tr>
			<tr>
				<th>Facture de la dépense</th>
				<td>{{ depense.factureDepense }}</td>
			</tr>
			<tr>
				<th>Kilomètres du véhicule</th>
				<td>{{ depense.kmVehicule ? depense.kmVehicule ~ ' km' : '' }}</td>
			</tr>
			<tr>
				<th>Prix du carburant au litre</th>
				<td>{{ depense.carbuPrixLitre ? depense.carbuPrixLitre ~ ' €/l' : '' }}</td>
			</tr>
			<tr>
				<th>Description de la réparation</th>
				<td>{{ depense.repaDescription }}</td>
			</tr>
			<tr>
				<th>Référence des pièces</th>
				<td>{{ depense.repaRefPieces }}</td>
			</tr>
			<tr>
				<th>Photos de la réparation</th>
				<td>{{ depense.repaPhotos }}</td>
			</tr>
		</tbody>
	</table>

	<div class="d-flex justify-content-between mb-3">
		<a href="{{ path('app_depense_index') }}" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			Retour à la liste</a>
		<a href="{{ path('app_depense_edit', {'id': depense.id}) }}" class="btn btn-primary">
			<i class="fas fa-edit"></i>
			Modifier</a>
		{{ include('depense/_delete_form.html.twig') }}
	</div>
{% endblock %}
