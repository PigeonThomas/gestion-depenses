<form method="post" action="{{ path('app_depense_delete', {'id': depense.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette dépense ?');">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ depense.id) }}">
	<button class="btn btn-danger">Supprimer
		<i class="fas fa-trash"></i>
	</button>
</form>
