{% extends 'base.html.twig' %}

{% block title %}
	{{ title }}
{% endblock %}

{% block body %}
	<h1>
		{{ title }}
	</h1>
	<h2>Voici la liste de vos dépenses</h2>
	<div class="container m-2">
		<table class="table">
			<thead>
				<tr>
					<th>{{ knp_pagination_sortable(depenses, 'Date', 'd.date_depense') }}</th>
					<th>{{ knp_pagination_sortable(depenses, 'Montant', 'd.montant_depense') }}</th>
					<th>Commentaire</th>
					<th>{{ knp_pagination_sortable(depenses, 'Catégorie', 'c.nom_categorie') }}</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for depense in depenses %}
					<tr>
						<td>{{ depense.dateDepense ? depense.dateDepense|date('d-m-Y') : '' }}</td>
						<td>{{ depense.montantDepense }}
							€</td>
						<td>{{ depense.commentaireDepense }}</td>
						<td>{{ depense.categorie.nomCategorie }}</td>
						<td>
							<a href="{{ path('app_depense_show', {'id': depense.id}) }}">
								<i class="fas fa-eye"></i>
							</a>
							<a href="{{ path('app_depense_edit', {'id': depense.id}) }}">
								<i class="fas fa-edit"></i>
							</a>
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="5">no records found</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
		<div class="d-flex justify-content-center">
			{{ knp_pagination_render(depenses) }}
		</div>
	</div>
{% endblock %}
