{% extends 'base.html.twig' %}

{% block title %}Dashboard
{% endblock %}

{% block body %}
	<div class="container my-3">
		<h1>
			<strong>Dashboard</strong>
		</h1>
		<h2>Bienvenue sur votre tableau de bord de gestion des dépenses !</h2>
		<p>
			Ici, vous pouvez suivre et gérer toutes vos dépenses liées à votre véhicule. 
																																																																																																																																													Que ce soit pour l'entretien, les réparations ou les frais de carburant, 
																																																																																																																																													notre tableau de bord vous offre une vue d'ensemble claire et organisée de toutes vos dépenses. 
																																																																																																																																													Utilisez les fonctionnalités pour ajouter, modifier ou supprimer des entrées, 
																																																																																																																																													et gardez un œil sur vos finances automobiles en toute simplicité.
		</p>

		<div class="container">
			<div class="row g-4">
				<div class="col">
					<div class="card bg-primary text-white" style="border-radius: 20px;">
						<div class="card-body">
							<h5 class="card-title">Dépenses du mois</h5>
							<p class="card-text">Total des dépenses pour le mois en cours :
								{{ totalDepenseActualMonth }}
								€</p>
						</div>
					</div>
				</div>
				<div class="col">
					<div class="card " style="border-radius: 20px;">
						<div class="card-body">
							<h5 class="card-title">Dépenses du mois précédent</h5>
							<p class="card-text">Total des dépenses pour le mois précédent :
								{{ totalDepenseLastMonth }}
								€</p>
						</div>
					</div>
				</div>
				<div class="col">
					<div class="card " style="border-radius: 20px;">
						<div class="card-body">
							<h5 class="card-title">Titre3</h5>
							<p class="card-text">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
						</div>
					</div>
				</div>
			</div>

			<div class="row g-4 mt-2">
				<div class="col-8">
					<div class="card " style="border-radius: 20px;">
						<div class="card-body">
							<h5 class="card-title">Titre4</h5>
							<p class="card-text">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
						</div>
					</div>
				</div>
				<div class="col-4">
					<div class="card " style="border-radius: 20px;">
						<div class="card-body">
							<h5 class="card-title">Titre5</h5>
							<p class="card-text">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="container m-2">
			<h3>Liste des dépenses</h3>
			<table class="table">
				<thead>
					<tr>
						<th>Id</th>
						<th>Date</th>
						<th>Montant</th>
						<th>Commentaire</th>
						<th>Facture</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for depense in depenses %}
						<tr>
							<td>{{ depense.id }}</td>
							<td>{{ depense.dateDepense ? depense.dateDepense|date('d-m-Y') : '' }}</td>
							<td>{{ depense.montantDepense }}
								€</td>
							<td>{{ depense.commentaireDepense }}</td>
							<td>{{ depense.factureDepense }}</td>
							<td>
								<a href="{{ path('app_depense_show', {'id': depense.id}) }}">
									<i class="fas fa-eye"></i>
								</a>
								<a href="{{ path('app_depense_edit', {'id': depense.id}) }}">
									<i class="fas fa-edit"></i>
								</a>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="6">no records found</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
{% endblock %}
