{% extends 'base.html.twig' %}

{% block title %}
	{{ title }}
{% endblock %}

{% block body %}
	<h1>{{ title }}</h1>

	<div class="row d-flex justify-content-center">
		<div class="col-10">
			<div class="card p-3 m-3" style="border-radius: 20px">
				{{ include('depense/_form.html.twig')}}
				<p>* Champs obligatoires</p>
			</div>
		</div>
	</div>

	<div class="d-flex justify-content-between mb-3">
		<a href="{{ path('app_depense_index') }}" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			Retour à la liste</a>
		{{ include('depense/_delete_form.html.twig') }}
	</div>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('js/depense-form.js') }}"></script>
{% endblock %}
