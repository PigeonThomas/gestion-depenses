{% extends 'base.html.twig' %}

{% block title %}
	{{ title }}
{% endblock %}

{% block body %}
	<h1>{{ title }}</h1>

	<div class="row d-flex justify-content-center">
		<div class="col-10">
			<div class="card p-3 m-3" style="border-radius: 20px">
				{{ include('vehicule/_form.html.twig', {'button_label': 'Update'}) }}
				<p>* Champs obligatoires</p>
			</div>
		</div>
	</div>

	<div class="d-flex justify-content-between mb-3">
		<a href="{{ path('app_vehicule_index') }}" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			Retour à la liste</a>
		{{ include('vehicule/_delete_form.html.twig') }}
	</div>
{% endblock %}
