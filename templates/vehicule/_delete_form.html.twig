<form method="post" action="{{ path('app_vehicule_delete', {'id': vehicule.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce véhicule ?');">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ vehicule.id) }}">
	<button class="btn btn-danger">Supprimer
		<i class="fas fa-trash"></i>
	</button>
</form>
