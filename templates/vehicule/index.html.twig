{% extends 'base.html.twig' %}

{% block title %}Vehicule index{% endblock %}

{% block body %}
    <h1>Vehicule index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Immat_vehicule</th>
                <th>Surnom_vehicule</th>
                <th>Type_vehicule</th>
                <th>Marque_vehicule</th>
                <th>Modele_vehicule</th>
                <th>Annee_circulation_vehicule</th>
                <th>Energie_vehicule</th>
                <th>KmAchat_vehicule</th>
                <th>Image_vehicule</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for vehicule in vehicules %}
            <tr>
                <td>{{ vehicule.id }}</td>
                <td>{{ vehicule.immatVehicule }}</td>
                <td>{{ vehicule.surnomVehicule }}</td>
                <td>{{ vehicule.typeVehicule }}</td>
                <td>{{ vehicule.marqueVehicule }}</td>
                <td>{{ vehicule.modeleVehicule }}</td>
                <td>{{ vehicule.anneeCirculationVehicule ? vehicule.anneeCirculationVehicule|date('Y-m-d') : '' }}</td>
                <td>{{ vehicule.energieVehicule }}</td>
                <td>{{ vehicule.kmAchatVehicule }}</td>
                <td>{{ vehicule.imageVehicule }}</td>
                <td>
                    <a href="{{ path('app_vehicule_show', {'id': vehicule.id}) }}">show</a>
                    <a href="{{ path('app_vehicule_edit', {'id': vehicule.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="11">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_vehicule_new') }}">Create new</a>
{% endblock %}
