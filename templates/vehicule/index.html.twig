{% extends 'base.html.twig' %}

{% block title %}
	{{ title }}
{% endblock %}

{% block body %}
	<div class="container-fluid my-3">
		<h1>
			{{ title }}
		</h1>
		<h2>Voici la liste de vos véhicules</h2>
		<p>
			Ici, vous pouvez suivre et gérer toutes vos véhicules.
		</p>

		<div class="row g-4 my-2">
			<div class="col-md-4">
				<div class="card " style="border-radius: 20px;">
					<div class="card-body">
						<h5 class="card-title">Kilométres parcourus</h5>
						<p class="card-text">Kilométres parcourus pour le mois en cours :
							<strong>
								{{ totalDistance }}
								km</strong>
						</p>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="card " style="border-radius: 20px;">
					<div class="card-body">
						<h5 class="card-title">Dépenses en essence</h5>
						<p class="card-text">Dépenses en essence en
							{{ mois }}/{{ annee }}
							:
							<strong>{{ totalEssenceActualMonth }}
								€</strong>
						</p>
						<p class="card-text">Dépenses en essence pour le mois en précédent :
							<strong>{{ totalEssenceLastMonth }}
								€</strong>
						</p>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="card " style="border-radius: 20px;">
					<div class="card-body">
						<h5 class="card-title">Dépenses en réparations</h5>
						<p class="card-text">Dépenses en réparations en
							{{ mois }}/{{ annee }}
							:
							<strong>{{ totalReparationActualMonth }}
								€</strong>
						</p>
						<p class="card-text">Dépenses en réparations pour le mois en précédent :
							<strong>{{ totalReparationLastMonth }}
								€</strong>
						</p>
					</div>
				</div>
			</div>
		</div>

		<div class="container">
			<div class="row g-4">
				{% for vehicule in vehicules %}
					<div class="col-lg-6">
						<div class="card" style="border-radius: 20px;">

							<div class="card-body row d-flex align-items-center">
								<h4 class="card-title text-center">{{ vehicule.surnomVehicule }}</h4>
								<div class="col-5">

									<div class="card-text">
										<p>{{ vehicule.immatVehicule }}</p>
										<p>{{ vehicule.marqueVehicule }}
											{{ vehicule.modeleVehicule }}</p>
										<p>{{ vehicule.anneeCirculationVehicule ? vehicule.anneeCirculationVehicule|date('Y') : '' }}</p>
										<p>{{ vehicule.energieVehicule ? vehicule.energieVehicule : '' }}</p>
										<p>{{ vehicule.kmAchatVehicule ? vehicule.kmAchatVehicule ~ ' km' : '' }}</p>
									</div>
								</div>
								<div class="card-image col">
									{% if vehicule.imageVehicule %}
										<img class="img-fluid" src="{{ vich_uploader_asset(vehicule, 'imageVehiculeFile') }}" alt="photo de {{ vehicule.surnomVehicule }}">
									{% endif %}
								</div>
							</div>
							<div class="card-footer d-flex justify-content-end gap-2">
								<a href="{{ path('app_vehicule_show', {'id': vehicule.id}) }}" class="btn btn-primary">
									<i class="fas fa-eye"></i>
									Détails</a>
								<a href="{{ path('app_vehicule_edit', {'id': vehicule.id}) }}" class="btn btn-secondary">
									<i class="fas fa-pencil-alt"></i>
									Modifier</a>
							</div>
						</div>
					</div>
				{% endfor %}
			</div>


		</div>
	</div>
{% endblock %}
