{#templates/partials/_bottom_navbar.html.twig#}
{% set currentRoute = app.request.attributes.get('_route') %}
{#Récupère la route actuelle pour déterminer quelle section est active#}

{# Détermine le chemin et le label de l'action rapide en fonction de la route actuelle #}
	{% if currentRoute == 'app_dashboard' %}
	{# Si on est sur la page du tableau de bord #}
	{% set actionPath = path('app_depense_new') %}
	{% set actionLabel = 'Ajouter une dépense' %}
{% elseif currentRoute == 'app_depense_index' %}
	{# Si on est sur la page des dépenses #}
	{% set actionPath = path('app_depense_new') %}
	{% set actionLabel = 'Ajouter une dépense' %}
{% elseif currentRoute == 'app_vehicule_index' %}
	{# Si on est sur la page des véhicules #}
	{% set actionPath = path('app_vehicule_new') %}
	{% set actionLabel = 'Ajouter un véhicule' %}
{% elseif currentRoute == 'app_magasin_index' %}
	{# Si on est sur la page des magasins #}
	{% set actionPath = path('app_magasin_new') %}
	{% set actionLabel = 'Ajouter un magasin' %}
{% elseif currentRoute == 'app_categorie_index' %}
	{# Si on est sur la page des catégories #}
	{% set actionPath = path('app_categorie_new') %}
	{% set actionLabel = 'Ajouter une catégorie' %}
{% else %}
	{% set actionPath = null %}
	{% set actionLabel = null %}
{% endif %}

{# Affiche le bouton d'action rapide si un chemin est défini pour la route actuelle #}
{% if actionPath %}
	<a href="{{ actionPath }}" class="btn btn-primary rounded-circle shadow position-fixed d-md-none d-flex align-items-center justify-content-center" style="right: 1.25rem; bottom: 5.75rem; width: 64px; height: 64px; z-index: 1045;" aria-label="{{ actionLabel }}">
		<i class="fa-solid fa-plus fs-4"></i>
	</a>
{% endif %}

<nav class="navbar fixed-bottom d-md-none bg-light border-top mx-2" style="z-index: 1040; border-top-left-radius: 1.5rem; border-top-right-radius: 1.5rem;" aria-label="Navigation mobile">
	<div class="container-fluid  px-2 py-2">
		<div class="row flex-nowrap text-center w-100 g-0 align-items-end">
			<div class="col">
				<a href="{{ path('app_dashboard') }}" class="text-decoration-none d-flex flex-column align-items-center justify-content-center small {{ currentRoute starts with 'app_dashboard' ? 'text-primary' : 'text-dark' }}" aria-current="{{ currentRoute starts with 'app_dashboard' ? 'page' : 'false' }}">
					<span class="d-inline-flex align-items-center justify-content-center rounded-pill px-3 py-2 {{ currentRoute starts with 'app_dashboard' ? 'bg-primary text-white shadow-sm' : '' }}" style="min-width: 82px;">
						<i class="fa-solid fa-house"></i>
					</span>
					<span class="mt-1" style="font-size: 0.72rem;">Dashboard</span>
				</a>
			</div>
			<div class="col">
				<a href="{{ path('app_depense_index') }}" class="text-decoration-none d-flex flex-column align-items-center justify-content-center small {{ currentRoute starts with 'app_depense_' ? 'text-primary' : 'text-dark' }}" aria-current="{{ currentRoute starts with 'app_depense_' ? 'page' : 'false' }}">
					<span class="d-inline-flex align-items-center justify-content-center rounded-pill px-3 py-2 {{ currentRoute starts with 'app_depense_' ? 'bg-primary text-white shadow-sm' : '' }}" style="min-width: 82px;">
						<i class="fa-solid fa-money-bill"></i>
					</span>
					<span class="mt-1" style="font-size: 0.72rem;">Dépenses</span>
				</a>
			</div>
			<div class="col">
				<a href="{{ path('app_vehicule_index') }}" class="text-decoration-none d-flex flex-column align-items-center justify-content-center small {{ currentRoute starts with 'app_vehicule_' ? 'text-primary' : 'text-dark' }}" aria-current="{{ currentRoute starts with 'app_vehicule_' ? 'page' : 'false' }}">
					<span class="d-inline-flex align-items-center justify-content-center rounded-pill px-3 py-2 {{ currentRoute starts with 'app_vehicule_' ? 'bg-primary text-white shadow-sm' : '' }}" style="min-width: 82px;">
						<i class="fa-solid fa-car"></i>
					</span>
					<span class="mt-1" style="font-size: 0.72rem;">Véhicules</span>
				</a>
			</div>
			<div class="col">
				<a href="{{ path('app_magasin_index') }}" class="text-decoration-none d-flex flex-column align-items-center justify-content-center small {{ currentRoute starts with 'app_magasin_' ? 'text-primary' : 'text-dark' }}" aria-current="{{ currentRoute starts with 'app_magasin_' ? 'page' : 'false' }}">
					<span class="d-inline-flex align-items-center justify-content-center rounded-pill px-3 py-2 {{ currentRoute starts with 'app_magasin_' ? 'bg-primary text-white shadow-sm' : '' }}" style="min-width: 82px;">
						<i class="fa-solid fa-store"></i>
					</span>
					<span class="mt-1" style="font-size: 0.72rem;">Magasins</span>
				</a>
			</div>
			{% if is_granted('ROLE_ADMIN') %}
				<div class="col">
					<a href="{{ path('app_categorie_index') }}" class="text-decoration-none d-flex flex-column align-items-center justify-content-center small {{ currentRoute starts with 'app_categorie_' ? 'text-primary' : 'text-dark' }}" aria-current="{{ currentRoute starts with 'app_categorie_' ? 'page' : 'false' }}">
						<span class="d-inline-flex align-items-center justify-content-center rounded-pill px-3 py-2 {{ currentRoute starts with 'app_categorie_' ? 'bg-primary text-white shadow-sm' : '' }}" style="min-width: 82px;">
							<i class="fa-solid fa-box"></i>
						</span>
						<span class="mt-1" style="font-size: 0.72rem;">Catégories</span>
					</a>
				</div>
				<div class="col">
					<a href="{{ path('app_user_index') }}" class="text-decoration-none d-flex flex-column align-items-center justify-content-center small {{ currentRoute starts with 'app_user_' ? 'text-primary' : 'text-dark' }}" aria-current="{{ currentRoute starts with 'app_user_' ? 'page' : 'false' }}">
						<span class="d-inline-flex align-items-center justify-content-center rounded-pill px-3 py-2 {{ currentRoute starts with 'app_user_' ? 'bg-primary text-white shadow-sm' : '' }}" style="min-width: 82px;">
							<i class="fa-solid fa-users"></i>
						</span>
						<span class="mt-1" style="font-size: 0.72rem;">Utilisateurs</span>
					</a>
				</div>
			{% endif %}
		</div>
	</div>
</nav>
