{% extends 'base.html.twig' %}

{% block title %}Créer un compte
{% endblock %}

{% block body %}
	{% include 'partials/_navbar.html.twig' %}

	<div class="d-flex align-items-center justify-content-center py-3">
		<div class="card shadow-sm border-0 w-100" style="max-width: 520px;">
			<div class="card-body p-4 p-md-5">

				<div class="text-center mb-4">
					<div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-4 mb-3" style="width: 56px; height: 56px;">
						<i class="fa-solid fa-user-plus fs-5"></i>
					</div>
					<h1 class="h4 fw-semibold mb-1">Créer un compte</h1>
					<p class="text-muted small">Inscrivez-vous pour accéder à votre espace ToolSpend.</p>
				</div>

				{{ form_errors(registrationForm) }}

				{{ form_start(registrationForm, { attr: { novalidate: 'novalidate' } }) }}

				<div class="row g-3">
					<div class="col-12">{{ form_row(registrationForm.email) }}</div>
					<div class="col-md-6">{{ form_row(registrationForm.nom_user) }}</div>
					<div class="col-md-6">{{ form_row(registrationForm.prenom_user) }}</div>
					<div class="col-12">{{ form_row(registrationForm.adresse_user) }}</div>
					<div class="col-12">{{ form_row(registrationForm.imageUserFile) }}</div>
					<div class="col-12">{{ form_row(registrationForm.plainPassword) }}</div>
					<div class="col-12">{{ form_row(registrationForm.agreeTerms) }}</div>
				</div>

				{{ form_row(registrationForm.save, { attr: { class: 'btn btn-primary w-100 py-2 mt-3' } }) }}

				{{ form_end(registrationForm) }}

				<p class="text-center text-muted small mt-4 mb-0">
					Déjà inscrit ?
					<a href="{{ path('app_login') }}" class="text-primary text-decoration-none fw-medium">Se connecter</a>
				</p>

			</div>
		</div>
	</div>
{% endblock %}
