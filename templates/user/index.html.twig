{% extends 'base.html.twig' %}

{% block title %}
	{{ title }}
{% endblock %}

{% block body %}
	<h1>{{ title }}</h1>

	{% for message in app.flashes('danger') %}
		<div class="alert alert-danger">{{ message }}</div>
	{% endfor %}

	<table class="table">
		<thead>
			<tr>
				<th>Id</th>
				<th>Photo</th>
				<th>Email</th>
				<th>Prénom</th>
				<th>Nom</th>
				<th>Rôles</th>
				<th>actions</th>
			</tr>
		</thead>
		<tbody>
			{% for user in users %}
				<tr>
					<td>{{ user.id }}</td>
					<td>
						{% if user.imageUser %}
							<img src="{{ vich_uploader_asset(user, 'imageUserFile') }}" alt="Avatar de {{ user.prenomUser ?: user.nomUser ?: user.userIdentifier }}" class="rounded-circle object-fit-cover" width="40" height="40">
						{% else %}
							<span class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
								<i class="fa-solid fa-user"></i>
							</span>
						{% endif %}
					</td>
					<td>{{ user.email }}</td>
					<td>{{ user.prenomUser }}</td>
					<td>{{ user.nomUser }}</td>
					<td>{{ user.roles|join(', ') }}</td>
					<td>
						<div class="d-flex gap-2 align-items-center">
							<a href="{{ path('app_user_edit', {'id': user.id}) }}">
								<i class="fas fa-edit"></i>
							</a>
						</div>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="7">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endblock %}
